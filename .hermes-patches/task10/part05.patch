+    ) -> None:
+        arguments = {
+            "delivery_id": "delivery",
+            "now": 1000.0,
+            "body_hash": "body",
+            "profile": "default",
+            "route": "route",
+            "provider": "github",
+        }
+        arguments.update(overrides)
+        with pytest.raises(ValueError, match=message):
+            _adapter()._record_delivery_id(**arguments)
+
+    def test_rate_limit_isolated_by_profile_and_route(self) -> None:
+        adapter = _adapter(rate_limit=1)
